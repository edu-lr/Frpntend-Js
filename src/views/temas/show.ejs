<a href="/temas" class="back-link">← Volver a temas</a>

<div class="tema-card featured" data-id="<%= tema.id %>">
    <h1><%= tema.titulo %></h1>
    <p class="descripcion"><%= tema.descripcion %></p>
    
    <div class="vote-container">
        <button type="button" class="btn-vote" onclick="votarTema(<%= tema.id %>, this)">👍 Votar</button>

        <span class="vote-count" id="votos-<%= tema.id %>">
            <%= tema.votos %>
        </span>
        <span class="vote-label">votos</span>
    </div>
    
    <div class="tema-actions">
        <a href="/temas/<%= tema.id %>/editar" class="btn btn-secondary">Editar</a>
        <form action="/temas/<%= tema.id %>?_method=DELETE" method="POST" style="display: inline;" onsubmit="return confirm('¿Estás seguro de eliminar este tema?')">
            <button type="submit" class="btn btn-danger">Eliminar</button>
        </form>
    </div>
</div>

<!-- Sección de enlaces -->
<section class="enlaces-section">
    <h2>🔗 Enlaces de Aprendizaje</h2>
    
    <!-- Formulario para agregar enlace -->
    <form id="form-agregar-enlace" class="form-inline">
        <input type="hidden" name="temaId" value="<%= tema.id %>">
        <div class="form-group">
            <input type="text" name="titulo" placeholder="Título del enlace (ej: Tutorial Ninja Code)" required>
        </div>
        <div class="form-group">
            <input type="url" name="url" placeholder="URL (https://...)" required>
        </div>
        <button type="submit" class="btn btn-primary">➕ Agregar</button>
    </form>
    
    <!-- Lista de enlaces -->
    <div id="enlaces-container">
        <% if (tema.enlaces && tema.enlaces.length > 0) { %>
            <% tema.enlaces.sort((a,b) => b.votos - a.votos).forEach(enlace => { %>
                <div class="enlace-item" data-enlace-id="<%= enlace.id %>">
                    <div class="enlace-info">
                        <a href="<%= enlace.url %>" target="_blank"><strong><%= enlace.titulo %></strong></a>
                        <span class="enlace-url"><%= enlace.url %></span>
                    </div>
                    <div class="enlace-vote">
                        <button type="button" class="btn-vote-enlace" onclick="votarEnlace(<%= tema.id %>, <%= enlace.id %>, this)">👍 Votar</button>

                        <span class="vote-count" id="votos-enlace-<%= enlace.id %>">
                            <%= enlace.votos %>
                        </span>
                    </div>
                    <div class="enlace-actions">
                        <button type="button" class="btn-editar-enlace" onclick="editarEnlaceForm(<%= tema.id %>, <%= enlace.id %>)">Editar</button>
                        <button type="button" class="btn-eliminar-enlace" onclick="eliminarEnlace(<%= tema.id %>, <%= enlace.id %>)">Eliminar</button>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <p>No hay enlaces todavía. ¡Agrega el primero!</p>
        <% } %>
    </div>
</section>